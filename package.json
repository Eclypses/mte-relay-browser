{
  "name": "mte-relay-browser",
  "version": "4.4.1",
  "description": "An MTE Relay module that runs in a Browser. It MTE encrypts all network requests, and depends on a server-side MTE Relay module.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "publish": "npm run build && npm publish",
    "publish:beta": "npm run build && npm publish --tag beta"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "peerDependencies": {
    "mte": "^4.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eclypses/mte-relay-browser"
  },
  "types": "./dist/types/index.d.ts"
}
